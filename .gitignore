# ==========================================
# 敏感配置文件与密钥 (Env & Credentials)
# ==========================================
.env
.env.*
*.env
**/.env
**/.env.*
# 保留配置模板供协作参考
!.env.example
!**/.env.example

# ==========================================
# Python 虚拟环境与包管理 (Virtual Environments)
# ==========================================
.venv/
**/.venv/
venv/
**/venv/
ENV/
**/ENV/

# Python 构建与分发产物
*.egg-info/
**/*.egg-info/
dist/
build/
eggs/
.eggs/
*.egg

# ==========================================
# 缓存文件与编译产物 (Cache & Bytecode)
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
tags

# 测试缓存与测试产物
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# 编辑器与系统生成文件 (IDEs & OS)
# ==========================================
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~:
.DS_Store
Thumbs.db

# ==========================================
# 临时工作区与运行产物 (Workspace / Logs)
# ==========================================
*.log
**/workspace/*
!**/workspace/.gitkeep
